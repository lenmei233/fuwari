---
import { Icon } from "astro-icon/components";

interface Props {
	/** page = 当前文章访问量（会自增）；site = 全站总访问量（只读显示，自增由脚本统一处理） */
	mode: "page" | "site";
	label?: string;
	icon?: string;
}

const { mode, label = "", icon = "material-symbols:visibility" } = Astro.props;
---

<span class="view-counter flex flex-row items-center" data-vc={mode}>
	<span
		class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
	>
		<Icon name={icon}></Icon>
	</span>
	<span class="text-sm">{label}{label ? " " : ""}<span class="vc-count">—</span></span>
</span>

<script>
	// 防止脚本被重复注入导致重复计数
	if (!(window as any).__vcInit) {
		(window as any).__vcInit = true;

		async function vcPost(path: string): Promise<number | null> {
			try {
				const res = await fetch(`/api/views?path=${encodeURIComponent(path)}`, {
					method: "POST",
				});
				if (!res.ok) return null;
				const data = await res.json();
				return typeof data.views === "number" ? data.views : null;
			} catch {
				return null;
			}
		}

		function fmt(n: number | null): string {
			return n == null ? "—" : n.toLocaleString();
		}

		async function vcUpdate() {
			// 全站访问量：每次页面访问 +1（整页仅一次）
			let siteViews: number | null = null;
			try {
				siteViews = await vcPost("__site__");
			} catch {}

			// 当前文章访问量（仅文章页有 [data-vc="page"]）
			const pageEl = document.querySelector('[data-vc="page"]');
			if (pageEl) {
				const v = await vcPost(location.pathname);
				const c = pageEl.querySelector(".vc-count");
				if (c) c.textContent = fmt(v);
			}

			// 更新所有“全站访问量”显示
			if (siteViews != null) {
				document
					.querySelectorAll('[data-vc="site"] .vc-count')
					.forEach((el) => {
						el.textContent = fmt(siteViews);
					});
			}
		}

		// 初始加载
		vcUpdate();

		// Swup 客户端路由切换后更新（@swup/astro 已开启 globalInstance）
		const swup = (window as any).swup;
		if (swup?.hooks) {
			swup.hooks.on("page:view", vcUpdate);
		}
		document.addEventListener("swup:page:view", vcUpdate);
	}
</script>
