---

import { profileConfig } from "../config";
import ViewCounter from "./ViewCounter.astro";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a><br>
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://icp.gov.moe/?keyword=blog.lenmei233.top">萌ICP备20240488号</a><br>
        <a class="transition link text-[var(--primary)] font-medium" href="https://icp.redcha.cn/beian/ICP-2025080031.html" target="_blank">茶ICP备2025080031号</a><br>
        <span class="mt-2 inline-block">本站重建后正常运行：</span>
        <span id="uptime" class="text-[var(--primary)] font-medium"></span><br>
        <span class="mt-2 inline-block">全站访问量：</span><ViewCounter mode="site"></ViewCounter>

    </div>
<script defer src="https://hananalytics-ksm.pages.dev/tracker.min.js" data-website-id="blog"></script>
<script>
        const launchDate = new Date(2025, 9, 1, 0, 0, 0).getTime();
        const uptimeElement = document.getElementById('uptime');

        // 计算并更新运行时间
        function updateUptime() {
            if (!uptimeElement) return;
            
            const now = new Date().getTime(); 
            const diff = now - launchDate; 
            
            // 转换为天、时、分、秒
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            // 格式化显示
            uptimeElement.textContent = `${days}天 ${String(hours).padStart(2, '0')}时 ${String(minutes).padStart(2, '0')}分 ${String(seconds).padStart(2, '0')}秒`;
        }

        // 初始执行一次
        updateUptime();
        // 每秒更新一次
        setInterval(updateUptime, 1000);
    </script>
</div>